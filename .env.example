# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Create the database in MySQL Workbench first (see README.md), then point
# this at it. Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql://root:yourpassword@127.0.0.1:3306/truetechs_db
